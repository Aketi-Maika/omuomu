[Unit]
Description=omuomu 写真展 管理ツール
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/srv/nas

[Service]
User=omuomu
Group=omuomu
Environment=HOME=/var/lib/omuomu
Environment=LANG=C.UTF-8
# 管理画面(8787)と公開 API(8788)は NAS の中（127.0.0.1）だけで待ち受ける。
# 管理画面は SSH トンネルで、公開 API は Tailscale Funnel / Cloudflare Tunnel で外とつなぐ
ExecStart=/opt/omuomu/bin/omuomu-gallery --root "@ROOT@" --port @PORT@ --public-port 8788 --no-open
Restart=on-failure
RestartSec=5
# Atom で写真の縮小中も Samba が重くならないように
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
