[Unit]
Description=omuomu 写真展 管理ツール
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/srv/nas

[Service]
User=omuomu
Group=omuomu
Environment=HOME=/var/lib/omuomu
Environment=LANG=C.UTF-8
ExecStart=/opt/omuomu/bin/omuomu-gallery --root "@ROOT@" --listen 0.0.0.0 --port @PORT@ --no-open
Restart=on-failure
RestartSec=5
# Atom で写真の縮小中も Samba が重くならないように
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
